# Copy to .env for local development. Never commit .env.
# Required variables have no default; the app refuses to start without them.

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Settings module: config.settings.local | test | production
DJANGO_SETTINGS_MODULE=config.settings.local
# Required in production: comma-separated hostnames.
DJANGO_ALLOWED_HOSTS=

# Required. compose.yaml overrides these two for containers; these values serve
# commands run on the host (uv run pytest, manage.py) against the compose ports.
DATABASE_URL=postgres://fleetflow:fleetflow@localhost:5432/fleetflow
REDIS_URL=redis://localhost:6379/0

# Optional. Seconds to keep DB connections open (default 60).
DB_CONN_MAX_AGE=60
# Optional, production only. HSTS max-age in seconds (default 31536000).
SECURE_HSTS_SECONDS=31536000

# Number of trusted reverse proxies in front of the app (0 locally). Decides which
# X-Forwarded-For entry is the client IP for throttles and audit; too high lets clients spoof it.
NUM_PROXIES=0
# Serve /api/schema/ and /api/docs/ (local settings force this on; keep off elsewhere).
API_DOCS_ENABLED=false

# Email. Local default prints to the console. Required in production, e.g.
# smtp+tls://user:password@smtp.example.com:587
EMAIL_URL=consolemail://
# Required in production.
DEFAULT_FROM_EMAIL=FleetFlow <no-reply@localhost>
# fleetflow-admin page that completes password set/reset (uid and token are appended).
# Required in production.
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Minimum driver-app version, e.g. 1.4.0. Older builds get HTTP 426. Empty disables the check.
DRIVER_APP_MIN_VERSION=
